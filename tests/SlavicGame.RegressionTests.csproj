<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="renderer/**/*.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <ProjectReference Include="../third_party/veldrid/Veldrid.csproj" />
    <Compile Include="../Engine/AI/*.cs" Link="AI/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Animation/*.cs" Link="Animation/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Assets/*.cs" Link="Assets/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Audio/*.cs"
             Exclude="../Engine/Audio/SdlPcmPlayer.cs;../Engine/Audio/VoiceOverService.cs;../Engine/Audio/RiverAmbienceService.cs;../Engine/Audio/AudioDirector.cs"
             Link="Audio/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Combat/*.cs" Link="Combat/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Dialogue/*.cs" Link="Dialogue/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Entity/*.cs" Link="Entity/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Gameplay/*.cs" Link="Gameplay/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Input/*.cs" Link="Input/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Interaction/*.cs" Link="Interaction/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Inventory/*.cs" Link="Inventory/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Gods/*.cs" Link="Gods/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Magic/*.cs" Link="Magic/%(Filename)%(Extension)" />
    <Compile Include="../Engine/NPC/*.cs" Link="NPC/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Physics/*.cs" Link="Physics/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Quest/*.cs" Link="Quest/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Reputation/*.cs" Link="Reputation/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Relationships/*.cs" Link="Relationships/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Save/*.cs" Link="Save/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Scene/*.cs" Link="Scene/%(Filename)%(Extension)" />
    <Compile Include="../Engine/UI/GameUiState.cs" Link="UI/GameUiState.cs" />
    <Compile Include="../Engine/Settings/*.cs" Link="Settings/%(Filename)%(Extension)" />
    <Compile Include="../Engine/World/*.cs" Link="World/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Core/GameTime.cs" Link="GameTime.cs" />
    <Compile Include="../Engine/Diagnostics/*.cs" Link="Diagnostics/%(Filename)%(Extension)" />
    <Compile Include="../Engine/Renderer/Camera3D.cs" Link="Camera3D.cs" />
    <Compile Include="../Engine/Renderer/BitmapFont.cs" Link="BitmapFont.cs" />
    <Compile Include="../Engine/Renderer/CameraFrustum.cs" Link="CameraFrustum.cs" />
    <Compile Include="../Engine/Renderer/CelestialLighting.cs" Link="CelestialLighting.cs" />
    <Compile Include="../Engine/Renderer/PresentationPolicy.cs" Link="PresentationPolicy.cs" />
    <Compile Include="../Engine/Renderer/VulkanRuntimeCompatibility.cs" Link="VulkanRuntimeCompatibility.cs" />
    <Compile Include="../Engine/Renderer/VulkanDeviceFactory.cs" Link="VulkanDeviceFactory.cs" />
    <Compile Include="../Engine/Renderer/TemporalFrameState.cs" Link="TemporalFrameState.cs" />
    <Compile Include="../Engine/Renderer/FidelityFx/FidelityFxStartupPolicy.cs" Link="FidelityFxStartupPolicy.cs" />
    <Compile Include="../Engine/Renderer/FidelityFx/FidelityFxVulkanCommands.cs" Link="FidelityFxVulkanCommands.cs" />
    <Compile Include="../Engine/Renderer/FidelityFx/FidelityFxVulkanDeviceHandles.cs" Link="FidelityFxVulkanDeviceHandles.cs" />
    <Compile Include="../Engine/Renderer/FidelityFx/FidelityFxNativeLibrary.cs" Link="FidelityFxNativeLibrary.cs" />
    <Compile Include="../Engine/Renderer/FidelityFx/FfxApiInterop.cs" Link="FfxApiInterop.cs" />
    <Compile Include="../Engine/Renderer/FidelityFx/FgApiInterop.cs" Link="FgApiInterop.cs" />
    <Compile Include="../Engine/Renderer/FidelityFx/FidelityFxFrameGeneration.cs" Link="FidelityFxFrameGeneration.cs" />
    <Compile Include="../Engine/Renderer/FidelityFx/FidelityFxUpscaler.cs" Link="FidelityFxUpscaler.cs" />
    <Compile Include="../Engine/Renderer/FidelityFx/FidelityFxVulkanInterop.cs" Link="FidelityFxVulkanInterop.cs" />
    <Content Include="../native/fidelityfx/*.so" Link="native/fidelityfx/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="native/fidelityfx/*.so" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Engine/Renderer/DynamicMotionHistory.cs" Link="DynamicMotionHistory.cs" />
    <Compile Include="../Engine/Renderer/WorldModelRenderPolicy.cs" Link="WorldModelRenderPolicy.cs" />
    <Content Include="../assets/audio/**/*.wav"
             Link="assets/audio/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../assets/models/**/*.glb"
             Link="assets/models/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../assets/textures/terrain/**/*.png"
             Link="assets/textures/terrain/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
