<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Veldrid" Version="4.9.0" />
    <PackageReference Include="Veldrid.StartupUtilities" Version="4.9.0" />
    <PackageReference Include="Veldrid.ImageSharp" Version="4.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="tools/tts/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="native/fidelityfx/**/*" Condition="Exists('native/fidelityfx')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CompileAndCopyVulkanShaders"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="&quot;$(MSBuildProjectDirectory)/tools/compile-shaders.sh&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <ItemGroup>
      <CompiledVulkanShader Include="$(MSBuildProjectDirectory)/shaders/bin/*.spv" />
    </ItemGroup>

    <Error Condition="'@(CompiledVulkanShader)' == ''"
           Text="Shader compilation completed but no SPIR-V files were produced in shaders/bin." />

    <MakeDir Directories="$(OutDir)shaders/bin" />
    <Copy SourceFiles="@(CompiledVulkanShader)"
          DestinationFolder="$(OutDir)shaders/bin"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyVulkanShadersToPublish"
          AfterTargets="Publish"
          Condition="'$(OS)' != 'Windows_NT'">
    <ItemGroup>
      <PublishedVulkanShader Include="$(MSBuildProjectDirectory)/shaders/bin/*.spv" />
    </ItemGroup>

    <MakeDir Directories="$(PublishDir)shaders/bin" />
    <Copy SourceFiles="@(PublishedVulkanShader)"
          DestinationFolder="$(PublishDir)shaders/bin"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
